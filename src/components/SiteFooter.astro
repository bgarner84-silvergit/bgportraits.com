---
import { site, legalNav } from '../data/site';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="shell">
		<div class="footer__top">
			<div class="footer__brand">
				<Wordmark />
				<p class="t-caption footer__blurb">{site.tagline}</p>
			</div>

			<address class="footer__contact t-caption">
				<span>{site.name}</span>
				<span>{site.address}</span>
				<a class="link-underline" href={site.phoneHref}>{site.phone}</a>
				<a class="link-underline" href={site.emailHref}>{site.email}</a>
			</address>

			<nav class="footer__legal" aria-label="Legal">
				{
					legalNav.map((item) => (
						<a class="t-caption link-underline" href={item.href}>
							{item.label}
						</a>
					))
				}
			</nav>
		</div>

		<hr class="rule" />

		<p class="footer__bottom t-caption">
			&copy; {year} {site.name}. All rights reserved.
		</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--carbon);
		border-top: 1px solid var(--graphite);
		padding-block: clamp(3rem, 2rem + 4vw, 4.5rem) 2.5rem;
	}

	.footer__top {
		display: grid;
		gap: 2.5rem;
		padding-bottom: 2.5rem;
	}

	.footer__blurb {
		margin-top: 0.75rem;
		max-width: 26ch;
	}

	/*
	 * Registered business name, address and phone. A2P 10DLC review looks for
	 * these — keep them rendered as text, not an image.
	 */
	.footer__contact {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		font-style: normal;
	}

	.footer__legal {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		align-items: flex-start;
	}

	.footer__bottom {
		padding-top: 1.5rem;
	}

	@media (min-width: 48rem) {
		.footer__top {
			grid-template-columns: 1.4fr 1fr auto;
			gap: 3rem;
		}
	}
</style>
