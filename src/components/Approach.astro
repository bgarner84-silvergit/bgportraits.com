---
const steps = [
	{
		n: '01',
		title: 'It starts in their head',
		body: 'Before the camera comes out we agree on what the finished portrait is: the pose, the light, the scene it will live in. The shoot exists to serve that picture.',
	},
	{
		n: '02',
		title: 'One athlete, one session',
		body: 'However long it takes. The session runs until the frame is right, not until the clock says stop — time and attention are what separate a portrait from a photograph.',
	},
	{
		n: '03',
		title: 'Built by hand, frame by frame',
		body: 'Every hero image is cut from its background, composited into an art-directed scene, graded and retouched individually. That is hours of work per image, and it is the whole point.',
	},
	{
		n: '04',
		title: 'Made to outlast the season',
		body: 'The framed piece is built to conservation standard: 100% cotton rag matting, museum-grade UV glazing, and fully reversible mounting, so nothing adhesive ever touches the print. It can be re-framed in thirty years without damage. Seasons end. This does not.',
	},
];
---

<section class="section approach" id="approach">
	<div class="shell">
		<div class="approach__grid">
			<div class="approach__intro">
				<h2 class="t-section">Built, not taken</h2>
				<p class="t-lead approach__lead">
					A photograph is captured in a fraction of a second. This is designed first, shot
					second, then built by hand — concept, composite, grade, retouch — until it is a
					finished piece of work. Then it is made into something you can hang for good.
				</p>
			</div>

			<ol class="approach__steps">
				{
					steps.map((step) => (
						<li class="approach__step">
							<span class="t-label approach__n">{step.n}</span>
							<h3 class="t-subhead">{step.title}</h3>
							<p class="t-body approach__body">{step.body}</p>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.approach {
		border-top: 1px solid var(--graphite);
	}

	.approach__grid {
		display: grid;
		gap: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
	}

	.approach__lead {
		margin-top: 1.5rem;
		color: var(--ash);
	}

	.approach__steps {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 2.5rem;
	}

	.approach__step {
		display: grid;
		gap: 0.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--graphite);
	}

	.approach__n {
		color: var(--amber);
	}

	.approach__body {
		color: var(--ash);
	}

	@media (min-width: 64rem) {
		.approach__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		}

		.approach__steps {
			gap: 3rem;
		}
	}
</style>
