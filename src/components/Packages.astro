---
import { packages } from '../data/packages';
---

<section class="section packages" id="packages">
	<div class="shell">
		<header class="packages__head">
			<h2 class="t-section">Packages</h2>
			<p class="t-body packages__intro">
				Every session is quoted individually, because every piece is planned individually.
				Tell me about your athlete and I will send pricing for the tier that fits.
			</p>
		</header>

		<div class="packages__grid">
			{
				packages.map((pkg) => (
					<article class:list={['pkg', pkg.emphasis && 'pkg--emphasis']}>
						{pkg.emphasis && <span class="t-label pkg__flag">Most chosen</span>}
						<h3 class="t-subhead pkg__name">{pkg.name}</h3>
						<p class="t-body pkg__summary">{pkg.summary}</p>

						<ul class="pkg__list">
							{pkg.includes.map((line) => (
								<li class="pkg__line">{line}</li>
							))}
						</ul>

						<a class="pkg__cta t-label link-underline" href="#inquire">
							Request pricing
						</a>
					</article>
				))
			}
		</div>

		<p class="t-caption packages__note">
			Large prints, framing and additional composites are quoted on request.
		</p>
	</div>
</section>

<style>
	.packages {
		border-top: 1px solid var(--graphite);
	}

	.packages__head {
		display: grid;
		gap: 1.25rem;
		margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
	}

	.packages__intro {
		color: var(--ash);
	}

	.packages__grid {
		display: grid;
		gap: 1px;
		background: var(--graphite);
		border-block: 1px solid var(--graphite);
	}

	/* Dividers only — the emphasis tier is marked by a rule, not a box. */
	.pkg {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		background: var(--black);
		padding: clamp(1.75rem, 1rem + 2vw, 2.5rem) clamp(1.25rem, 0.5rem + 2vw, 2rem);
	}

	.pkg--emphasis {
		background: var(--carbon);
	}

	.pkg__flag {
		color: var(--amber);
	}

	.pkg__summary {
		color: var(--ash);
	}

	.pkg__list {
		list-style: none;
		padding: 0;
		margin-top: 0.5rem;
		display: grid;
		gap: 0.75rem;
		flex: 1;
	}

	.pkg__line {
		position: relative;
		padding-inline-start: 1.25rem;
		font-size: var(--size-body);
		line-height: 1.5;
	}

	.pkg__line::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		inset-block-start: 0.6875em;
		width: 0.5rem;
		height: 1px;
		background: var(--amber);
	}

	.pkg__cta {
		align-self: flex-start;
		margin-top: 1rem;
		color: var(--bone);
	}

	.packages__note {
		margin-top: 1.5rem;
	}

	@media (min-width: 56rem) {
		.packages__grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.packages__head {
			grid-template-columns: auto minmax(0, 48ch);
			align-items: end;
			justify-content: space-between;
			gap: 3rem;
		}
	}
</style>
