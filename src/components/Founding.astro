---
import { founding, foundingBlocks } from '../data/founding';
---

<section class="section founding" id="founding">
	<div class="shell">
		<header class="founding__head">
			<h2 class="t-section">Founding Families</h2>
			<p class="t-body founding__intro">{founding.intro}</p>
		</header>

		<div class="founding__grid">
			{
				foundingBlocks.map((block) => (
					<article class:list={['block', block.emphasis && 'block--emphasis']}>
						<h3 class="t-subhead block__title">{block.title}</h3>
						<p class="t-body block__summary">{block.summary}</p>

						<ul class="block__list">
							{block.lines.map((line) => (
								<li class="block__line">{line}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>

		<div class="founding__foot">
			<p class="t-body founding__pricing">{founding.pricingNote}</p>
			<a class="founding__cta t-label link-underline" href="#inquire">
				Become a founding family
			</a>
		</div>
	</div>
</section>

<style>
	.founding {
		border-top: 1px solid var(--graphite);
	}

	.founding__head {
		display: grid;
		gap: 1.25rem;
		margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
	}

	.founding__intro {
		color: var(--ash);
	}

	.founding__grid {
		display: grid;
		gap: 1px;
		background: var(--graphite);
		border-block: 1px solid var(--graphite);
	}

	/* Dividers only. The commission block is marked by a lifted ground, not a box. */
	.block {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		background: var(--black);
		padding: clamp(1.75rem, 1rem + 2vw, 2.5rem) clamp(1.25rem, 0.5rem + 2vw, 2rem);
	}

	.block--emphasis {
		background: var(--carbon);
	}

	.block__summary {
		color: var(--ash);
	}

	.block__list {
		list-style: none;
		padding: 0;
		margin-top: 0.5rem;
		display: grid;
		gap: 0.75rem;
	}

	.block__line {
		position: relative;
		padding-inline-start: 1.25rem;
		font-size: var(--size-body);
		line-height: 1.5;
	}

	.block__line::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		inset-block-start: 0.6875em;
		width: 0.5rem;
		height: 1px;
		background: var(--amber);
	}

	.founding__foot {
		display: grid;
		gap: 1.25rem;
		margin-top: 2rem;
		max-width: 60ch;
	}

	.founding__pricing {
		color: var(--ash);
	}

	.founding__cta {
		justify-self: start;
		color: var(--bone);
	}

	@media (min-width: 56rem) {
		.founding__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.founding__head {
			grid-template-columns: auto minmax(0, 52ch);
			align-items: end;
			justify-content: space-between;
			gap: 3rem;
		}
	}
</style>
