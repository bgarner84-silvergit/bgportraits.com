---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import signature from '../assets/signature.png';

/*
 * Placeholder bio. Brandon replaces this copy in Phase 4 (docs/project-plan.md).
 * The section image was removed in session 7 — it showed the client's athlete,
 * not Brandon. Follow-up item: add Brandon's own profile photo here.
 */
---

<section class="section about" id="about">
	<div class="shell">
		<div class="about__grid">
			<div class="about__body">
				<h2 class="t-section">About</h2>

				<p class="t-lead about__lead">
					I am Brandon Garner. I photograph one athlete at a time, out of {
						`${site.locality}, ${site.region}`
					}.
				</p>

				<p class="t-body about__para">
					I started doing this the way most people do — shooting games, handing over a
					gallery, moving on. The pictures were fine. None of them ended up on a wall.
				</p>

				<p class="t-body about__para">
					So I changed the job. Now every athlete gets a session built around them and one
					finished piece that took real hours to make: cut out by hand, composited onto a
					scene we planned together, graded and retouched until it holds up printed large.
					It is slower and it does not scale, and that is exactly why it looks the way it
					does.
				</p>

				<p class="t-body about__para">
					If that is the kind of portrait you want for your athlete, get in touch and tell
					me about them.
				</p>

				<Image
					src={signature}
					alt="Brandon Garner"
					widths={[220, 440]}
					sizes="220px"
					loading="lazy"
					decoding="async"
					class="about__signature"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		border-top: 1px solid var(--graphite);
	}

	.about__body {
		max-width: 46rem;
	}

	.about__lead {
		margin-top: 1.5rem;
		color: var(--bone);
	}

	.about__para {
		margin-top: 1.25rem;
		color: var(--ash);
	}

	.about__signature {
		width: 13.75rem;
		height: auto;
		margin-top: 2.25rem;
		opacity: 0.9;
	}
</style>
