---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import signature from '../assets/signature.png';
import brandon from '../assets/brandon.jpg';

/*
 * Placeholder bio. Brandon replaces this copy in Phase 4 (docs/project-plan.md).
 *
 * The section image was removed in session 7 because it showed the client's
 * athlete rather than Brandon. Replaced 2026-09-19 with his own portrait,
 * cropped to head and shoulders from a full-length original. This is the
 * "liking" asset the Cialdini pass flagged as open: the page is a person
 * making a case, so a face belongs next to it.
 */
---

<section class="section about" id="about">
	<div class="shell">
		<div class="about__grid">
			<div class="about__body">
				<h2 class="t-section">About</h2>

				<p class="t-lead about__lead">
					I am Brandon Garner. I build custom portraits for individual athletes, out of {
						`${site.locality}, ${site.region}`
					}.
				</p>

				<p class="t-body about__para">
					I started doing this the way most people do: shooting games, handing over a
					gallery, moving on. The pictures were fine. None of them ended up on a wall.
				</p>

				<p class="t-body about__para">
					So I changed the job. Now every athlete gets a session built around them and one
					finished piece that took real hours to make: cut out by hand, composited onto a
					scene we planned together, graded and retouched until it holds up printed large.
					It is slower and it does not scale, and that is exactly why it looks the way it
					does.
				</p>

				<p class="t-body about__para">
					If that is the kind of portrait you want for your athlete, get in touch and tell
					me about them.
				</p>

				<Image
					src={signature}
					alt="Brandon Garner"
					widths={[220, 440]}
					sizes="220px"
					loading="lazy"
					decoding="async"
					class="about__signature"
				/>
			</div>

			<figure class="about__figure">
				<div class="about__frame">
					<Image
						src={brandon}
						alt="Brandon Garner, photographer, in a blue jacket against a warm grey background."
						widths={[320, 480, 640, 960]}
						sizes="(min-width: 64rem) 340px, 60vw"
						loading="lazy"
						decoding="async"
						class="about__portrait"
					/>
				</div>
			</figure>
		</div>
	</div>
</section>

<style>
	.about {
		border-top: 1px solid var(--graphite);
	}

	.about__grid {
		display: grid;
		gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
		align-items: start;
	}

	.about__body {
		max-width: 46rem;
	}

	/* Capped so the portrait reads as a print beside the text, not a banner. */
	.about__figure {
		max-width: min(21rem, 70%);
	}

	/* Same hairline treatment as the hero print. No shadow, no elevation. */
	.about__frame {
		border: 1px solid var(--graphite);
		padding: clamp(0.4rem, 0.3rem + 0.4vw, 0.625rem);
	}

	.about__portrait {
		display: block;
		width: 100%;
		height: auto;
	}

	.about__lead {
		margin-top: 1.5rem;
		color: var(--bone);
	}

	.about__para {
		margin-top: 1.25rem;
		color: var(--ash);
	}

	.about__signature {
		width: 13.75rem;
		height: auto;
		margin-top: 2.25rem;
		opacity: 0.9;
	}

	@media (min-width: 64rem) {
		.about__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 0.42fr);
			gap: clamp(3rem, 1rem + 5vw, 5rem);
		}

		.about__figure {
			max-width: 100%;
		}
	}
</style>
