---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import Approach from '../components/Approach.astro';
import Packages from '../components/Packages.astro';
import About from '../components/About.astro';
import Inquire from '../components/Inquire.astro';
import { site } from '../data/site';

const title = `${site.name} | Custom Athlete Portraits in ${site.locality}, ${site.region}`;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': `${site.url}/#business`,
	name: site.name,
	description: site.description,
	url: site.url,
	telephone: site.phone,
	email: site.email,
	image: `${site.url}/favicon.svg`,
	address: {
		'@type': 'PostalAddress',
		streetAddress: '7921 Ember Oaks Dr',
		addressLocality: site.locality,
		addressRegion: site.region,
		postalCode: '76182',
		addressCountry: 'US',
	},
	areaServed: 'Dallas–Fort Worth, Texas',
	priceRange: '$$$',
};
---

<Base title={title}>
	<Hero />
	<Gallery />
	<Approach />
	<Packages />
	<About />
	<Inquire />

	<script
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(structuredData)}
	/>
</Base>
