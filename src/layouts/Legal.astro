---
import Base from './Base.astro';

interface Props {
	title: string;
	heading: string;
	updated: string;
}

const { title, heading, updated } = Astro.props;
---

<Base title={title} minimalHeader>
	<article class="legal section">
		<div class="legal__shell">
			<a class="t-label legal__back link-underline" href="/">&larr; Back to home</a>
			<h1 class="t-section legal__title">{heading}</h1>
			<p class="t-caption legal__updated">Last updated: {updated}</p>

			<div class="prose">
				<slot />
			</div>
		</div>
	</article>
</Base>

<style>
	.legal__shell {
		width: 100%;
		max-width: 46rem;
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.legal__back {
		display: inline-block;
		color: var(--ash);
		margin-bottom: 2.5rem;
	}

	.legal__updated {
		margin-top: 0.75rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--graphite);
	}
</style>

<style is:global>
	.prose h2 {
		font-family: var(--font-display);
		font-stretch: var(--width-condensed);
		font-weight: 700;
		font-size: var(--size-subhead);
		text-transform: uppercase;
		letter-spacing: -0.01em;
		margin-top: 2.75rem;
		margin-bottom: 0.875rem;
	}

	.prose p,
	.prose li {
		color: var(--ash);
		font-size: var(--size-body);
		line-height: 1.7;
		max-width: var(--measure);
	}

	.prose p {
		margin-top: 1rem;
	}

	.prose ul {
		margin-top: 1rem;
		padding-inline-start: 1.25rem;
		display: grid;
		gap: 0.5rem;
	}

	.prose a {
		color: var(--bone);
		background-image: linear-gradient(var(--amber), var(--amber));
		background-size: 0 1px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size var(--dur) var(--ease), color var(--dur) var(--ease);
	}

	.prose a:hover {
		background-size: 100% 1px;
		color: var(--amber);
	}
</style>
